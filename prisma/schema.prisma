generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model QuoteRequest {
  id        String   @id @default(cuid())
  name      String
  company   String
  phone     String?
  email     String?
  message   String
  status    String   @default("YENI") // YENI | GORUSULDU | KAPANDI
  createdAt DateTime @default(now())
}
